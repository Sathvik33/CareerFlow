# ==============================================================================
# CareerFlow Backend Environment Configuration
# ==============================================================================

# Database: NeonDB PostgreSQL connection string (supports pgvector)
# Use 'postgresql+psycopg://' for psycopg v3 driver
DATABASE_URL=postgresql+psycopg://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require

# Groq API for Fast LLM Reasoning
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEY_2=gsk_optional_fallback_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Cohere API for 384-dim text embeddings (embed-english-light-v3.0)
COHERE_API_KEY=your_cohere_api_key_here

# JWT Authentication Secrets
SECRET_KEY=generate_a_secure_random_32_byte_hex_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional Email / Notification Service (SMTP)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Optional Job Board APIs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
